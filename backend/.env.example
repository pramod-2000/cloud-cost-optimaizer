# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Application database connection used by FastAPI.
# For docker compose, keep host as "db".
DATABASE_URL=postgresql://ai_cost_user:ai_cost_password@db:5432/ai_cloud_cost_detective

# Local Postgres container settings.
POSTGRES_DB=ai_cloud_cost_detective
POSTGRES_USER=ai_cost_user
POSTGRES_PASSWORD=ai_cost_password
POSTGRES_PORT=5432

# AWS credentials used by the AWS CLI inside the API container.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials
